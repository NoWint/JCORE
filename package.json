{
  "name": "jcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Journal of Computing and Open Research for Exploration",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:search": "npm run build && pagefind --site dist",
    "check": "npm run typecheck && npm run lint && npm run build:search && npm run test:unit && tsx scripts/validate/built-site.ts",
    "test:built": "npm run build:search && tsx scripts/validate/built-site.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:e2e": "bash scripts/run-e2e.sh",
    "jcore": "tsx scripts/jcore.ts",
    "validate": "npm run typecheck && npm run lint && npm run test:unit && tsx scripts/validate/content.ts && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/tar": "^6.1.13",
    "cheerio": "^1.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "fast-xml-parser": "^5.11.0",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.4",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tar": "^7.5.22",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
