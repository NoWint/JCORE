---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { getExternalArticleBySlug, getExternalArticles } from '../../../../lib/content/queries';
import { toArticleCard } from '../../../../lib/content/view-models';
import { renderArticle } from '../../../../lib/article/render';
import { getRelatedArticles } from '../../../../lib/article/related';
import { getSiteConfig } from '../../../../lib/site-config';
import { isLocale, LOCALES, type Locale } from '../../../../lib/i18n';

export function getStaticPaths() {
  const articles = getExternalArticles();
  return LOCALES.flatMap((lang) => articles.map((article) => ({ params: { lang, slug: article.slug } })));
}

const rawLocale = Astro.params.lang ?? 'en';
const locale: Locale = isLocale(rawLocale) ? rawLocale : 'en';
const config = getSiteConfig(import.meta.env as Record<string, string | undefined>);
const record = getExternalArticleBySlug(Astro.params.slug ?? '');
if (!record) {
  throw new Error(`Missing external article ${Astro.params.slug}`);
}
const articleBody = record.bodyByLocale?.[locale] ?? record.body;
const renderReport =
  record.renderMode === 'structured'
    ? await renderArticle(articleBody, { base: config.base })
    : undefined;
const related = getRelatedArticles(record).map((article) => toArticleCard(article, locale, config.base));
const citationUrls = {
  plain: `${config.base}/citations/${record.slug}.txt`,
  bib: `${config.base}/citations/${record.slug}.bib`,
  ris: `${config.base}/citations/${record.slug}.ris`
};
---
<ArticleLayout
  locale={locale}
  record={record}
  renderReport={renderReport}
  related={related}
  citationUrls={citationUrls}
/>
