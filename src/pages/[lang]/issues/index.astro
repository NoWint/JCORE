---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getIssues } from '../../../lib/content/queries';
import { toIssueCard } from '../../../lib/content/view-models';
import { getSiteConfig } from '../../../lib/site-config';
import { isLocale, LOCALES, type Locale } from '../../../lib/i18n';
import { makeRoute } from '../../../lib/routes';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? 'en';
const locale: Locale = isLocale(rawLocale) ? rawLocale : 'en';
const config = getSiteConfig(import.meta.env as Record<string, string | undefined>);
const issues = getIssues().map((issue) => toIssueCard(issue, locale, config.base));
const title = locale === 'zh' ? '卷期' : 'Issues';
---
<PageLayout
  locale={locale}
  title={`${title} · JCORE`}
  description="JCORE volumes and issues"
  canonical={new URL(makeRoute(locale, 'issues', config.base), config.site.origin)}
>
  <h1 class="page-title">{title}</h1>
  <div class="issue-list">
    {issues.map((issue) => (
      <a class="issue-link" href={issue.url}>
        <strong>{issue.title}</strong>
        <span>{issue.year}</span>
      </a>
    ))}
  </div>
</PageLayout>
