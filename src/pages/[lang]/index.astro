---
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/discovery/ArticleCard.astro';
import {
  getArticlesForIssue,
  getFeaturedExternalArticles,
  getIssues,
  getPublishedArticles
} from '../../lib/content/queries';
import { toArticleCard } from '../../lib/content/view-models';
import { getSiteConfig } from '../../lib/site-config';
import { isLocale, localize, LOCALES, type Locale } from '../../lib/i18n';
import { makeRoute } from '../../lib/routes';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? 'en';
const locale: Locale = isLocale(rawLocale) ? rawLocale : 'en';
const config = getSiteConfig(import.meta.env as Record<string, string | undefined>);
const issues = getIssues();
const currentIssue = issues[0];
const issueArticles = currentIssue ? getArticlesForIssue(currentIssue.id) : [];
const latestArticles = [...getPublishedArticles()]
  .sort((a, b) => b.dates.published.getTime() - a.dates.published.getTime())
  .slice(0, 2)
  .map((article) => toArticleCard(article, locale, config.base));
const featured = getFeaturedExternalArticles().map((article) => toArticleCard(article, locale, config.base));
const categories = [
  { label: 'Artificial Intelligence', href: makeRoute(locale, 'articles?category=ai', config.base) },
  { label: 'Machine Learning', href: makeRoute(locale, 'articles?category=ml', config.base) },
  { label: 'Computer Systems', href: makeRoute(locale, 'articles?category=systems', config.base) },
  { label: 'Algorithms', href: makeRoute(locale, 'articles?category=algorithms', config.base) },
  { label: 'Programming Languages', href: makeRoute(locale, 'articles?category=pl', config.base) },
  { label: 'Human-Computer Interaction', href: makeRoute(locale, 'articles?category=hci', config.base) },
  { label: 'Computer Vision', href: makeRoute(locale, 'articles?category=vision', config.base) },
  { label: 'NLP', href: makeRoute(locale, 'articles?category=nlp', config.base) },
  { label: 'AI Safety', href: makeRoute(locale, 'articles?category=safety', config.base) },
  { label: 'Computational Neuroscience', href: makeRoute(locale, 'articles?category=neuro', config.base) }
];
---
<PageLayout
  locale={locale}
  title="JCORE"
  description="Journal of Computing and Open Research for Exploration"
  canonical={new URL(makeRoute(locale, '', config.base), config.site.origin)}
>
  <section class="journal-intro">
    <p class="journal-kicker">Journal of Computing and Open Research for Exploration</p>
    <h1 class="journal-title">JCORE</h1>
    <p class="journal-tagline">
      An open research journal for young scholars and emerging contributors in computing and artificial intelligence.
    </p>
  </section>

  <section class="home-section">
    <h2 class="section-heading">Current Issue</h2>
    {
      currentIssue && (
        <div class="issue-banner">
          <a href={makeRoute(locale, `issues/${currentIssue.id}`, config.base)}>
            <strong>{localize(currentIssue.title, locale)}</strong>
            <span>{currentIssue.year}</span>
          </a>
          <span class="issue-count">{issueArticles.length} JCORE articles</span>
        </div>
      )
    }
  </section>

  <section class="home-section">
    <h2 class="section-heading">Latest Articles</h2>
    <div class="article-grid">
      {latestArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section class="home-section">
    <h2 class="section-heading">Featured Research</h2>
    <div class="article-grid">
      {featured.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section class="home-section">
    <h2 class="section-heading">Research Categories</h2>
    <ul class="category-list">
      {categories.map((category) => <li><a href={category.href}>{category.label}</a></li>)}
    </ul>
  </section>
</PageLayout>
