---
import { getSiteConfig } from '../lib/site-config';

const { base } = getSiteConfig(import.meta.env as Record<string, string | undefined>);
const englishUrl = `${base}/en/`;
const chineseUrl = `${base}/zh/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${englishUrl}`} />
    <link rel="canonical" href={englishUrl} />
    <title>JCORE</title>
  </head>
  <body>
    <main>
      <h1>JCORE</h1>
      <p>Journal of Computing and Open Research for Exploration</p>
      <p><a href={englishUrl}>Continue to JCORE in English</a></p>
      <p><a href={chineseUrl} lang="zh">中文</a></p>
    </main>
  </body>
</html>
