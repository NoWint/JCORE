---
const { kind, demo = false } = Astro.props as { kind: 'jcore' | 'external'; demo?: boolean };
const label = kind === 'external' ? 'External Open-Access Article' : 'JCORE Article';
const classes = ['ownership-badge', kind === 'external' ? 'is-external' : '', demo ? 'is-demo' : '']
  .filter(Boolean)
  .join(' ');
---
<span class={classes}>{label}{demo ? ' · Demonstration' : ''}</span>
