---
import { getSiteConfig } from "../../lib/site-config";
import { getIssues } from "../../lib/content/queries";
import { localize } from "../../lib/i18n";
import { makeRoute } from "../../lib/routes";
import type { Locale } from "../../lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { locale, path = "" } = Astro.props as { locale: Locale; path?: string };
const config = getSiteConfig(
  import.meta.env as Record<string, string | undefined>,
);
const route = (target: string) => makeRoute(locale, target, config.base);
const languagePath = Astro.url.pathname
  .replace(config.base, "")
  .replace(/^\/+/, "");

const navigation = [
  { label: { en: "Articles", zh: "文章" }, href: route("articles") },
  { label: { en: "Issues", zh: "期刊" }, href: route("issues") },
  { label: { en: "Authors", zh: "作者" }, href: route("authors") },
  { label: { en: "Submit", zh: "投稿" }, href: route("submit") },
  { label: { en: "About", zh: "关于" }, href: route("about") },
  { label: { en: "Policies", zh: "政策" }, href: route("policies") },
];

const currentIssue = getIssues()[0];
const issueHref = currentIssue
  ? route(`issues/${currentIssue.id}`)
  : route("articles");
const isCurrent = (href: string) => path === href;
const drawerCopy =
  locale === "zh"
    ? {
        open: "打开导航",
        close: "关闭导航",
        navigation: "导航",
        explore: "浏览 JCORE",
        latestIssue: "最新一期",
        issueMeta: "第",
        issueDescription: "浏览本期收录的研究文章。",
      }
    : {
        open: "Open navigation",
        close: "Close navigation",
        navigation: "Navigation",
        explore: "Explore JCORE",
        latestIssue: "Latest issue",
        issueMeta: "Vol.",
        issueDescription: "Read the research collected in this issue.",
      };
---

<header class="site-header">
  <div class="masthead">
    <button
      class="masthead-toggle"
      type="button"
      aria-label={drawerCopy.open}
      aria-expanded="false"
      aria-controls="jcore-site-nav"
      data-label-open={drawerCopy.open}
      data-label-close={drawerCopy.close}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

    <a class="masthead-brand" href={route("")}>
      <span class="journal-name">
        <span class="journal-title">JCORE</span>
        <small>Journal of Computing and Open Research for Exploration</small>
      </span>
    </a>

    <div class="masthead-actions">
      <a class="icon-button" href={route("search")} aria-label="Search">
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <LanguageSwitcher current={locale} path={languagePath} />
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        aria-pressed="false"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 1 9 9"></path>
        </svg>
      </button>
      <a class="masthead-btn" href={route("articles")}>Explore</a>
    </div>
  </div>

  <div class="station-bar">
    <div class="station-inner">
      <nav class="site-nav" aria-label="Main">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {localize(item.label, locale)}
            </a>
          ))
        }
      </nav>
      <a class="station-cta" href={issueHref}>Get the latest papers</a>
    </div>
  </div>

  <div class="nav-drawer-backdrop" data-nav-backdrop hidden></div>
  <aside
    class="nav-drawer"
    id="jcore-site-nav"
    data-nav-drawer
    aria-label="Site navigation"
    aria-modal="true"
    hidden
  >
    <div class="nav-drawer-header">
      <div class="nav-drawer-identity">
        <span class="nav-drawer-kicker">JCORE</span>
        <span class="nav-drawer-heading">{drawerCopy.navigation}</span>
      </div>
      <button
        class="nav-drawer-close"
        type="button"
        data-nav-close
        aria-label={drawerCopy.close}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
    <nav class="nav-drawer-links" aria-label={drawerCopy.navigation}>
      <p class="nav-drawer-section-label">{drawerCopy.explore}</p>
      {
        navigation.map((item, index) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            <span class="nav-drawer-index">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="nav-drawer-label">{localize(item.label, locale)}</span>
          </a>
        ))
      }
    </nav>
    <div class="nav-drawer-footer">
      <p class="nav-drawer-section-label">{drawerCopy.latestIssue}</p>
      {
        currentIssue && (
          <a class="nav-drawer-issue" href={issueHref}>
            <span class="nav-drawer-issue-meta">
              {locale === "zh"
                ? `第 ${currentIssue.volume} 卷 · 第 ${currentIssue.issue} 期 · ${currentIssue.year}`
                : `${drawerCopy.issueMeta} ${currentIssue.volume} · Issue ${currentIssue.issue} · ${currentIssue.year}`}
            </span>
            <strong>{localize(currentIssue.title, locale)}</strong>
            <span class="nav-drawer-issue-description">
              {drawerCopy.issueDescription}
            </span>
          </a>
        )
      }
    </div>
  </aside>
</header>

<script is:inline>
  const root = document.documentElement;
  const body = document.body;
  const drawerToggle = document.querySelector(".masthead-toggle");
  const drawer = document.getElementById("jcore-site-nav");
  const drawerBackdrop = document.querySelector("[data-nav-backdrop]");
  const drawerClose = document.querySelector("[data-nav-close]");
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const mobileViewport = window.matchMedia("(max-width: 720px)");

  const setDrawerState = (open, restoreFocus = false) => {
    if (!drawerToggle || !drawer) return;
    drawer.hidden = !open;
    if (drawerBackdrop) drawerBackdrop.hidden = !open;
    body?.classList.toggle("nav-drawer-open", open);
    drawerToggle.setAttribute("aria-expanded", String(open));
    drawerToggle.setAttribute(
      "aria-label",
      open
        ? (drawerToggle.dataset.labelClose ?? "Close navigation")
        : (drawerToggle.dataset.labelOpen ?? "Open navigation"),
    );
    if (open) {
      drawerClose?.focus();
    } else if (restoreFocus) {
      drawerToggle.focus();
    }
  };

  const syncThemeState = () => {
    if (!themeToggle) return;
    const dark = root.dataset.theme === "dark";
    themeToggle.setAttribute("aria-pressed", String(dark));
    themeToggle.setAttribute(
      "aria-label",
      dark ? "Use light theme" : "Use dark theme",
    );
  };

  setDrawerState(false);
  syncThemeState();

  drawerToggle?.addEventListener("click", () => {
    setDrawerState(Boolean(drawer?.hidden));
  });

  drawerClose?.addEventListener("click", () => setDrawerState(false, true));
  drawerBackdrop?.addEventListener("click", () => setDrawerState(false, true));

  drawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setDrawerState(false));
  });

  document.addEventListener("keydown", (event) => {
    if (!drawer || drawer.hidden) return;

    if (event.key === "Escape") {
      setDrawerState(false, true);
      return;
    }

    if (event.key !== "Tab") return;
    const focusable = Array.from(
      drawer.querySelectorAll(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    );
    if (focusable.length === 0) {
      event.preventDefault();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  const closeDrawerOnDesktop = () => {
    if (!mobileViewport.matches && drawer && !drawer.hidden) {
      setDrawerState(false);
    }
  };
  window.addEventListener("resize", closeDrawerOnDesktop);
  mobileViewport.addEventListener?.("change", closeDrawerOnDesktop);

  document.addEventListener("pointerdown", (event) => {
    if (
      drawer &&
      !drawer.hidden &&
      event.target instanceof Node &&
      !drawer.contains(event.target) &&
      event.target !== drawerToggle
    ) {
      setDrawerState(false, true);
    }
  });

  themeToggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("jcore-theme", next);
    } catch {
      // Storage can be unavailable in privacy-restricted browsers.
    }
    syncThemeState();
  });
</script>
