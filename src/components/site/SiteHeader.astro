---
import { getSiteConfig } from "../../lib/site-config";
import { getIssues } from "../../lib/content/queries";
import { makeRoute } from "../../lib/routes";
import type { Locale } from "../../lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { locale, path = "" } = Astro.props as { locale: Locale; path?: string };
const config = getSiteConfig(
  import.meta.env as Record<string, string | undefined>,
);
const route = (target: string) => makeRoute(locale, target, config.base);
const languagePath = Astro.url.pathname
  .replace(config.base, "")
  .replace(/^\/+/, "");

const navigation = [
  { label: "Articles", href: route("articles") },
  { label: "Issues", href: route("issues") },
  { label: "Authors", href: route("authors") },
  { label: "Submit", href: route("submit") },
  { label: "About", href: route("about") },
  { label: "Policies", href: route("policies") },
];

const currentIssue = getIssues()[0];
const issueHref = currentIssue
  ? route(`issues/${currentIssue.id}`)
  : route("articles");
---

<header class="site-header">
  <div class="masthead">
    <button
      class="masthead-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="jcore-site-nav"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

    <a class="masthead-brand" href={route("")}>
      <span class="journal-name">
        <span class="journal-title">JCORE</span>
        <small>Journal of Computing and Open Research for Exploration</small>
      </span>
    </a>

    <div class="masthead-actions">
      <a class="icon-button" href={route("search")} aria-label="Search">
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <LanguageSwitcher current={locale} path={languagePath} />
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        aria-pressed="false"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 1 9 9"></path>
        </svg>
      </button>
      <a class="masthead-btn" href={route("articles")}>Explore</a>
    </div>
  </div>

  <div class="station-bar">
    <div class="station-inner">
      <nav class="site-nav" aria-label="Main">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="station-cta" href={issueHref}>Get the latest papers</a>
    </div>
  </div>

  <div class="nav-drawer" id="jcore-site-nav" data-nav-drawer hidden>
    <nav class="nav-drawer-links" aria-label="Drawer">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const header = document.querySelector(".site-header");
  const drawerToggle = document.querySelector(".masthead-toggle");
  const drawer = document.getElementById("jcore-site-nav");
  const themeToggle = document.querySelector("[data-theme-toggle]");

  const setDrawerState = (open, restoreFocus = false) => {
    if (!drawerToggle || !drawer) return;
    drawer.hidden = !open;
    drawerToggle.setAttribute("aria-expanded", String(open));
    drawerToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    if (restoreFocus) drawerToggle.focus();
  };

  const syncThemeState = () => {
    if (!themeToggle) return;
    const dark = root.dataset.theme === "dark";
    themeToggle.setAttribute("aria-pressed", String(dark));
    themeToggle.setAttribute("aria-label", dark ? "Use light theme" : "Use dark theme");
  };

  setDrawerState(false);
  syncThemeState();

  drawerToggle?.addEventListener("click", () => {
    setDrawerState(Boolean(drawer?.hidden));
  });

  drawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setDrawerState(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawer && !drawer.hidden) {
      setDrawerState(false, true);
    }
  });

  document.addEventListener("pointerdown", (event) => {
    if (drawer && !drawer.hidden && header && !header.contains(event.target)) {
      setDrawerState(false, true);
    }
  });

  themeToggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("jcore-theme", next);
    } catch {
      // Storage can be unavailable in privacy-restricted browsers.
    }
    syncThemeState();
  });
</script>
