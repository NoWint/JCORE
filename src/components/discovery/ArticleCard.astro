---
import OwnershipBadge from "../site/OwnershipBadge.astro";
import {
  articleTypeLabel,
  type ArticleCardViewModel,
} from "../../lib/content/view-models";

const { article } = Astro.props as { article: ArticleCardViewModel };
const typeLabel = articleTypeLabel(article.articleType);
---

<article
  class="article-card"
  data-kind={article.isExternal ? "external" : "jcore"}
  data-article-type={article.articleType}
>
  <div class="article-card-top">
    <span class="article-card-type">{typeLabel}</span>
    <span class="article-card-date">{article.publishedAt}</span>
  </div>
  <h2 class="article-card-title">
    <a href={article.url}>{article.title}</a>
  </h2>
  <p class="article-card-authors">{article.authors.join(", ")}</p>
  {
    article.keywords.length > 0 && (
      <ul class="keyword-list" aria-label="Keywords">
        {article.keywords.slice(0, 5).map((keyword) => (
          <li>{keyword}</li>
        ))}
      </ul>
    )
  }
  <OwnershipBadge
    kind={article.isExternal ? "external" : "jcore"}
    demo={article.demo}
  />
</article>
