---
import SiteLayout from "./SiteLayout.astro";
import OwnershipBadge from "../components/site/OwnershipBadge.astro";
import { getAuthorById } from "../lib/content/queries";
import type {
  ArticleRecord,
  ExternalArticleRecord,
} from "../lib/content/types";
import type { ArticleCardViewModel } from "../lib/content/view-models";
import { articleTypeLabel } from "../lib/content/view-models";
import { localize, formatDate, type Locale } from "../lib/i18n";
import type { Heading } from "../lib/article/render";

const {
  locale,
  record,
  html,
  headings = [],
  related = [],
  citationUrls,
} = Astro.props as {
  locale: Locale;
  record: ArticleRecord | ExternalArticleRecord;
  html: string;
  headings?: Heading[];
  related?: ArticleCardViewModel[];
  citationUrls: { plain: string; bib: string; ris: string };
};

const isExternal = record.kind === "external";
const title = localize(record.title, locale);
const abstract = localize(record.abstract, locale);
const authorNames = isExternal
  ? record.contributors.map((contributor) => contributor.name)
  : record.authors
      .slice()
      .sort((a, b) => a.order - b.order)
      .map((ref) =>
        localize(
          getAuthorById(ref.authorId)?.name ?? { en: ref.authorId },
          locale,
        ),
      );
const published = isExternal
  ? formatDate(record.originalPublicationDate, locale)
  : formatDate(record.dates.published, locale);
const received = !isExternal
  ? formatDate(record.dates.received, locale)
  : undefined;
const accepted = !isExternal
  ? formatDate(record.dates.accepted, locale)
  : undefined;
const metaParts = isExternal
  ? [record.originalVenue, "External Article"]
  : [
      `Volume ${record.volume}, Issue ${record.issue}`,
      articleTypeLabel(record.articleType),
    ];
---

<SiteLayout locale={locale} title={`${title} · JCORE`} description={abstract}>
  <article class="article-page">
    <header class="article-header">
      <div class="article-kicker">
        <OwnershipBadge
          kind={record.kind}
          demo={"demo" in record ? record.demo : false}
        />
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-authors">{authorNames.join(", ")}</p>
      <p class="article-meta">
        {metaParts.map((part) => <span>{part}</span>)}
        <span>{published}</span>
      </p>
    </header>

    <section class="abstract-block">
      <span class="abstract-label">Abstract</span>
      <p>{abstract}</p>
    </section>

    <div class="article-layout">
      <aside class="article-sidebar">
        {
          headings.length > 0 && (
            <nav class="article-toc" aria-label="Table of contents">
              <h2 class="sidebar-heading">Contents</h2>
              <ol>
                {headings.map((heading, index) => (
                  <li>
                    <a href={`#${heading.id}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>{" "}
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          (received || accepted) && (
            <div class="sidebar-note">
              {received && <p>Received {received}</p>}
              {accepted && <p>Accepted {accepted}</p>}
              <p>Published {published}</p>
            </div>
          )
        }
      </aside>

      <div class="article-body">
        <div class="article-prose" set:html={html} />
      </div>

      <aside class="article-rail">
        <section class="citation-panel">
          <h2 class="sidebar-heading">Cite This Paper</h2>
          <div class="citation-links">
            <a href={citationUrls.plain}>Plain Text</a>
            <a href={citationUrls.bib}>BibTeX</a>
            <a href={citationUrls.ris}>RIS</a>
          </div>
        </section>

        {
          isExternal && (
            <section class="rights-panel">
              <h2 class="sidebar-heading">Source &amp; Rights</h2>
              <p>External open-access article · Not published by JCORE.</p>
              <p>
                Original:{" "}
                <a href={record.officialUrl}>{record.originalVenue}</a>
              </p>
              <p>
                License:{" "}
                <a href={record.rights.license.url}>
                  {record.rights.license.id}
                </a>
              </p>
              <p>{record.rights.statement}</p>
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="related-panel">
              <h2 class="sidebar-heading">Related</h2>
              <div class="rail-list">
                {related.map((article) => (
                  <div class="rail-item">
                    <h3 class="rail-item-title">
                      <a href={article.url}>{article.title}</a>
                    </h3>
                    <div class="rail-item-meta">
                      <span>{article.publishedAt}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </aside>
    </div>
  </article>
</SiteLayout>
