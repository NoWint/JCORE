---
import SiteLayout from "./SiteLayout.astro";
import ReaderControls from "../components/article/ReaderControls.astro";
import OwnershipBadge from "../components/site/OwnershipBadge.astro";
import { getAuthorById } from "../lib/content/queries";
import type {
  ArticleRecord,
  ExternalArticleRecord,
} from "../lib/content/types";
import type { ArticleCardViewModel } from "../lib/content/view-models";
import { articleTypeLabel } from "../lib/content/view-models";
import { localize, formatDate, type Locale } from "../lib/i18n";
import type { ArticleRenderReport, Heading } from "../lib/article/render";
import { getSiteConfig } from "../lib/site-config";

const {
  locale,
  record,
  html = "",
  headings = [],
  renderReport,
  related = [],
  citationUrls,
} = Astro.props as {
  locale: Locale;
  record: ArticleRecord | ExternalArticleRecord;
  html?: string;
  headings?: Heading[];
  renderReport?: ArticleRenderReport;
  related?: ArticleCardViewModel[];
  citationUrls: { plain: string; bib: string; ris: string };
};

const config = getSiteConfig(
  import.meta.env as Record<string, string | undefined>,
);
const isExternal = record.kind === "external";
const isFallback = record.renderMode === "source-fallback";
const renderedHtml = renderReport?.html ?? html;
const hasReadableBody = !isFallback && renderedHtml.trim().length > 0;
const indexedHeadings = renderReport?.headings ?? headings;
const tocHeadings = indexedHeadings.filter((heading) => heading.level <= 3);
const renderDiagnostics =
  record.conversionDiagnostics ?? renderReport?.diagnostics ?? [];
const title = localize(record.title, locale);
const abstract = localize(record.abstract, locale);
const sourceUrl = (path: string) =>
  path.startsWith("/") && !path.startsWith(`${config.base}/`)
    ? `${config.base}${path}`
    : path;
const sourceFiles = record.sourceFiles.map((file) => ({
  ...file,
  href: sourceUrl(file.path),
}));
const pdfSource = sourceFiles.find((file) => file.kind === "pdf");
const authorNames = isExternal
  ? record.contributors.map((contributor) => contributor.name)
  : record.authors
      .slice()
      .sort((a, b) => a.order - b.order)
      .map((ref) =>
        localize(
          getAuthorById(ref.authorId)?.name ?? { en: ref.authorId },
          locale,
        ),
      );
const published = isExternal
  ? formatDate(record.originalPublicationDate, locale)
  : formatDate(record.dates.published, locale);
const received = !isExternal
  ? formatDate(record.dates.received, locale)
  : undefined;
const accepted = !isExternal
  ? formatDate(record.dates.accepted, locale)
  : undefined;
const metaParts = isExternal
  ? [record.originalVenue, "External Article"]
  : [
      `Volume ${record.volume}, Issue ${record.issue}`,
      articleTypeLabel(record.articleType),
    ];
---

<SiteLayout
  locale={locale}
  title={`${title} · JCORE`}
  description={abstract}
  isArticle
>
  <article class="article-page">
    <header class="article-header">
      <div class="article-header-tools">
        <div class="article-kicker">
          <OwnershipBadge
            kind={record.kind}
            demo={"demo" in record ? record.demo : false}
          />
        </div>
        {hasReadableBody && <ReaderControls locale={locale} />}
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-authors">{authorNames.join(", ")}</p>
      <p class="article-meta">
        {metaParts.map((part) => <span>{part}</span>)}
        <span>{published}</span>
      </p>
    </header>

    <section class="abstract-block">
      <span class="abstract-label">Abstract</span>
      <p>{abstract}</p>
    </section>

    <div class="article-layout">
      <aside class="article-sidebar">
        {
          tocHeadings.length > 0 && (
            <nav class="article-toc" aria-label="Table of contents">
              <h2 class="sidebar-heading">Contents</h2>
              <ol>
                {tocHeadings.map((heading, index) => (
                  <li>
                    <a href={`#${heading.id}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>{" "}
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          (received || accepted) && (
            <div class="sidebar-note">
              {received && <p>Received {received}</p>}
              {accepted && <p>Accepted {accepted}</p>}
              <p>Published {published}</p>
            </div>
          )
        }
      </aside>

      <div class="article-body">
        {
          isFallback ? (
            <section
              class="conversion-notice"
              aria-labelledby="conversion-notice-title"
            >
              <p class="conversion-kicker">Source preserved</p>
              <h2 id="conversion-notice-title">
                Structured full text is unavailable
              </h2>
              <p>
                The structured conversion did not pass the publication
                preflight. This page keeps the article metadata and abstract
                visible without presenting an empty body as the full paper.
              </p>
              <dl class="conversion-details">
                <div>
                  <dt>Importer</dt>
                  <dd>{record.conversion.importer}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>{record.conversion.status}</dd>
                </div>
                <div>
                  <dt>Report</dt>
                  <dd>{record.conversion.reportPath}</dd>
                </div>
              </dl>
              {renderDiagnostics.length > 0 && (
                <ul class="conversion-diagnostics">
                  {renderDiagnostics.map((diagnostic) => (
                    <li>
                      <strong>{diagnostic.severity}</strong>:{" "}
                      {diagnostic.message}
                    </li>
                  ))}
                </ul>
              )}
              {sourceFiles.length > 0 && (
                <div class="source-files">
                  <h3>Original files</h3>
                  <ul>
                    {sourceFiles.map((file) => (
                      <li>
                        <a
                          href={file.href}
                          download
                          target={file.kind === "pdf" ? "_blank" : undefined}
                          rel="noreferrer"
                        >
                          {file.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {pdfSource && (
                <embed
                  class="source-pdf-preview"
                  src={pdfSource.href}
                  type="application/pdf"
                  title="Original PDF preview"
                />
              )}
              {isExternal && (
                <p class="conversion-official-link">
                  <a href={record.officialUrl}>Open the official source</a>
                </p>
              )}
            </section>
          ) : (
            renderedHtml.trim() && (
              <div class="article-prose" set:html={renderedHtml} />
            )
          )
        }
      </div>

      <aside class="article-rail">
        <section class="citation-panel">
          <h2 class="sidebar-heading">Cite This Paper</h2>
          <div class="citation-links">
            <a href={citationUrls.plain}>Plain Text</a>
            <a href={citationUrls.bib}>BibTeX</a>
            <a href={citationUrls.ris}>RIS</a>
          </div>
        </section>

        {
          isExternal && (
            <section class="rights-panel">
              <h2 class="sidebar-heading">Source &amp; Rights</h2>
              <p>External open-access article · not published by JCORE.</p>
              <p>
                Original:{" "}
                <a href={record.officialUrl}>{record.originalVenue}</a>
              </p>
              <p>
                License:{" "}
                <a href={record.rights.license.url}>
                  {record.rights.license.id}
                </a>
              </p>
              <p>{record.rights.statement}</p>
            </section>
          )
        }

        {
          !isFallback && sourceFiles.length > 0 && (
            <section class="source-files-panel">
              <h2 class="sidebar-heading">Source Files</h2>
              <ul class="source-files">
                {sourceFiles.map((file) => (
                  <li>
                    <a
                      href={file.href}
                      download
                      target={file.kind === "pdf" ? "_blank" : undefined}
                      rel="noreferrer"
                    >
                      {file.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="related-panel">
              <h2 class="sidebar-heading">Related</h2>
              <div class="rail-list">
                {related.map((article) => (
                  <div class="rail-item">
                    <h3 class="rail-item-title">
                      <a href={article.url}>{article.title}</a>
                    </h3>
                    <div class="rail-item-meta">
                      <span>{article.publishedAt}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </aside>
    </div>
  </article>
</SiteLayout>
